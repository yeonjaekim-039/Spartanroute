# Copy to .env and fill in. Never commit .env.

# Free token: https://511.org/open-data/token
API_511_KEY=

# 511 operator IDs: SC = VTA, BA = BART
AGENCIES=SC,BA

# 2 agencies every 180s = 40 requests/hour (511 default limit is 60/hour)
POLL_INTERVAL_SECONDS=180
HOURLY_REQUEST_LIMIT=60

# Optional: also save raw protobuf feeds (gzipped) so you can re-parse later.
# Roughly a few hundred MB per month for two agencies.
# ARCHIVE_DIR=/data/raw

POSTGRES_PASSWORD=change-me
